<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cloudticket.mapper.SessionMapper">

    <!-- ① 到开售时间 → 销售中（0 未开售 → 1 销售中）；条件更新，重复执行幂等 -->
    <update id="startSale">
        UPDATE show_session SET status = 1
        WHERE status = 0 AND sale_start_time &lt;= NOW()
    </update>

    <!-- ② 演出时间已过 → 已结束（1 销售中 → 2 已结束） -->
    <update id="endSession">
        UPDATE show_session SET status = 2
        WHERE status = 1 AND session_time &lt; NOW()
    </update>
</mapper>
